<!--
  Rules for MongoDB Atlas logs decoded by local_decoder_mongodb_atlas.xml (fields mongodb.*).
  Use together with that decoder only. With the module patch nested-json.sh use
  local_rules_mongodb_atlas.xml (fields aws.log.*) instead.
  Install: copy to /var/ossec/etc/rules/ (owner root:wazuh, mode 660). Remove any older MongoDB rules
  with ids 100220 to 100233 from local_rules.xml first, then
    /var/ossec/bin/wazuh-analysisd -t && systemctl restart wazuh-manager
-->
<group name="aws,mongodb,mongodb_atlas,">

  <!-- mongod and mongos lines -->
  <rule id="100220" level="3">
    <decoded_as>json</decoded_as>
    <field name="mongodb.component">\.+</field>
    <description>MongoDB Atlas [$(mongodb.cluster)] $(mongodb.component): $(mongodb.msg)</description>
  </rule>

  <rule id="100221" level="7">
    <if_sid>100220</if_sid>
    <field name="mongodb.msg">^Authentication failed$</field>
    <description>MongoDB Atlas [$(mongodb.cluster)]: authentication failed for user $(mongodb.user) on $(mongodb.db) from $(mongodb.remote): $(mongodb.error)</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100222" level="10" frequency="8" timeframe="120">
    <if_matched_sid>100221</if_matched_sid>
    <same_field>mongodb.remote</same_field>
    <description>MongoDB Atlas [$(mongodb.cluster)]: multiple authentication failures from $(mongodb.remote)</description>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100223" level="3">
    <if_sid>100220</if_sid>
    <field name="mongodb.msg">^Authentication succeeded$|^Successfully authenticated$</field>
    <description>MongoDB Atlas [$(mongodb.cluster)]: user $(mongodb.user) authenticated from $(mongodb.remote)</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100227" level="3">
    <if_sid>100220</if_sid>
    <field name="mongodb.msg">^Connection accepted$|^Connection ended$</field>
    <description>MongoDB Atlas [$(mongodb.cluster)]: $(mongodb.msg) from $(mongodb.remote), $(mongodb.connection_count) connections open</description>
  </rule>

  <rule id="100228" level="3">
    <if_sid>100220</if_sid>
    <field name="mongodb.msg">^Connection not authenticating$</field>
    <description>MongoDB Atlas [$(mongodb.cluster)]: connection from $(mongodb.remote) closed without authenticating</description>
  </rule>

  <rule id="100224" level="5">
    <if_sid>100220</if_sid>
    <field name="mongodb.severity">^E$|^F$</field>
    <description>MongoDB Atlas [$(mongodb.cluster)]: server error or fatal message $(mongodb.component): $(mongodb.msg)</description>
  </rule>

  <rule id="100225" level="5">
    <if_sid>100220</if_sid>
    <field name="mongodb.msg">^Slow query$</field>
    <description>MongoDB Atlas [$(mongodb.cluster)]: slow query on $(mongodb.ns), $(mongodb.duration_ms) ms</description>
  </rule>

  <rule id="100226" level="7">
    <if_sid>100220</if_sid>
    <field name="mongodb.code_name">^Unauthorized$</field>
    <description>MongoDB Atlas [$(mongodb.cluster)]: unauthorized command from $(mongodb.ctx): $(mongodb.errmsg)</description>
    <group>access_denied,</group>
  </rule>

  <!-- audit lines -->
  <rule id="100230" level="3">
    <decoded_as>json</decoded_as>
    <field name="mongodb.atype">\.+</field>
    <description>MongoDB Atlas audit [$(mongodb.cluster)]: $(mongodb.atype) by $(mongodb.user) from $(mongodb.remote), result $(mongodb.result)</description>
  </rule>

  <rule id="100231" level="8">
    <if_sid>100230</if_sid>
    <field name="mongodb.atype">^createUser$|^dropUser$|^updateUser$|^grantRolesToUser$|^revokeRolesFromUser$|^createRole$|^dropRole$</field>
    <description>MongoDB Atlas audit [$(mongodb.cluster)]: user or role change $(mongodb.atype) by $(mongodb.user)</description>
  </rule>

  <rule id="100232" level="8">
    <if_sid>100230</if_sid>
    <field name="mongodb.atype">^dropDatabase$|^dropCollection$|^shutdown$</field>
    <description>MongoDB Atlas audit [$(mongodb.cluster)]: destructive operation $(mongodb.atype) by $(mongodb.user)</description>
  </rule>

  <rule id="100233" level="7">
    <if_sid>100230</if_sid>
    <field name="mongodb.atype">^authenticate$</field>
    <field name="mongodb.result">^18$</field>
    <description>MongoDB Atlas audit [$(mongodb.cluster)]: authentication failure for $(mongodb.user) from $(mongodb.remote)</description>
    <group>authentication_failed,</group>
  </rule>

</group>
